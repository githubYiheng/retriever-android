<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 上传批次与拉远程配置 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- registerDefaultNetworkCallback（只用于网络恢复时提前唤醒） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- JobInfo.Builder.setPersisted(true) 的前提：没有它 schedule() 直接抛 IllegalArgumentException -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          后台兜底上传（方案 §3.9；ADR 0003 决定 13）：进后台 / fatal 时排一个一次性作业，
          网络约束、持久化；只有系统（持有 BIND_JOB_SERVICE）能绑定它。
        -->
        <service
            android:name="org.revdog.retriever.RetrieverUploadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          只记下 Application context、注册进程级前后台 tracker（不做任何磁盘 I/O），让 configure 之前的 log() 也能落盘
          （ADR 0023：写进 pre 文件，configure 时收编）、前后台状态从进程一开始就对。只在默认进程实例化；
          initOrder 调高：早于多数库的 provider（App Startup 等默认 0），它们构造期打的日志也有 context 可写。
          宿主可用 tools:node="remove" 去掉（之后 configure 之前的行只计数）。
        -->
        <provider
            android:name="org.revdog.retriever.RetrieverInitProvider"
            android:authorities="${applicationId}.retriever-init"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
